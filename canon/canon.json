{
  "schema": "causari.canon.v1",
  "revised": "2026-09-21",
  "identity": {
    "name": "Causari",
    "wordmark": "causari",
    "binary": "causari",
    "alias": "re",
    "one_liner": "AI-written code has no author. It has causes. Causari records them.",
    "sub_line": "How many lines from AI-tagged commits are still alive in your repo? One command, any git repo, no setup. A count, not a grade.",
    "domain": "causari.dev",
    "repo": "https://github.com/croviatrust/causari",
    "family": "Crovia",
    "family_url": "https://croviatrust.com",
    "family_canon": "https://github.com/croviatrust/crovia/blob/main/canon/canon.json",
    "trademark_holder": "Crovia Trust",
    "security_contact": "security@croviatrust.com",
    "legal_entity": "Crovia Trust",
    "git_author": "Crovia Trust <info@croviatrust.com>"
  },
  "glyphs": {
    "mark": "∵",
    "proves": "⊢",
    "separator": "·",
    "dash": "—",
    "palette": {
      "ink": "#0b0d10",
      "paper": "#f5f4ef",
      "graphite": "#3b4252",
      "mist": "#9aa3ad"
    },
    "rule": "Numbers never carry colour. Traffic-light glyphs and colour classes on a measurement are defects."
  },
  "version_sources": {
    "rule": "One version everywhere: Cargo.toml is the source; every other file that names a version must match it.",
    "files": [
      {
        "path": "Cargo.toml",
        "pattern": "^version = \"([0-9]+\\.[0-9]+\\.[0-9]+)\""
      },
      {
        "path": "site/index.html",
        "pattern": "\"softwareVersion\": \"([0-9]+\\.[0-9]+\\.[0-9]+)\""
      },
      {
        "path": "site/index.html",
        "pattern": "· v([0-9]+\\.[0-9]+\\.[0-9]+)</p>"
      },
      {
        "path": "server.json",
        "pattern": "^  \"version\": \"([0-9]+\\.[0-9]+\\.[0-9]+)\""
      },
      {
        "path": "server.json",
        "pattern": "^      \"version\": \"([0-9]+\\.[0-9]+\\.[0-9]+)\""
      },
      {
        "path": ".claude-plugin/marketplace.json",
        "pattern": "\"version\": \"([0-9]+\\.[0-9]+\\.[0-9]+)\""
      },
      {
        "path": "plugin/.claude-plugin/plugin.json",
        "pattern": "\"version\": \"([0-9]+\\.[0-9]+\\.[0-9]+)\""
      },
      {
        "path": "packaging/npm/package.json",
        "pattern": "^  \"version\": \"([0-9]+\\.[0-9]+\\.[0-9]+)\""
      },
      {
        "path": "packaging/pypi/pyproject.toml",
        "pattern": "^version = \"([0-9]+\\.[0-9]+\\.[0-9]+)\""
      },
      {
        "path": "CITATION.cff",
        "pattern": "^version: ([0-9]+\\.[0-9]+\\.[0-9]+)$"
      }
    ]
  },
  "surfaces": {
    "text": [
      "README.md",
      "MANIFESTO.md",
      "ROADMAP.md",
      "CONTRIBUTING.md",
      "DCO.md",
      "NOTICE",
      "action.yml",
      "site/index.html",
      "site/reports/survival/index.html",
      "site/r/index.html",
      "site/r/croviatrust/causari/index.html",
      "site/method.html",
      "site/llms.txt",
      "site/README.md",
      "docs/survival-report.md",
      "site/verify/index.html",
      "packaging/README.md",
      "packaging/npm/README.md",
      "packaging/pypi/README.md",
      "site/faq.html",
      "site/compare.html",
      "site/facts.html"
    ],
    "html": [
      "site/index.html",
      "site/reports/survival/index.html",
      "site/r/index.html",
      "site/r/croviatrust/causari/index.html",
      "site/method.html",
      "site/verify/index.html",
      "site/faq.html",
      "site/compare.html",
      "site/facts.html"
    ],
    "required_files": [
      "site/assets/mark.svg",
      "site/assets/mark-white.svg",
      "site/assets/favicon.svg",
      "site/assets/og.png",
      "site/_headers",
      "site/_redirects",
      "site/llms.txt",
      "site/robots.txt",
      "site/sitemap.xml",
      "site/install.sh",
      "site/install.ps1",
      "site/reports/survival/index.html",
      "site/reports/survival/feed.xml",
      "site/reports/survival/latest.json",
      "site/r/index.html",
      "site/verify/index.html",
      "site/verify/verify.js",
      "site/verify/seal-core.js"
    ],
    "identical_pairs": [
      [
        "scripts/install.sh",
        "site/install.sh"
      ],
      [
        "scripts/install.ps1",
        "site/install.ps1"
      ],
      [
        "LICENSE",
        "packaging/npm/LICENSE"
      ],
      [
        "LICENSE",
        "packaging/pypi/LICENSE"
      ]
    ],
    "generated": {
      "rule": "site/reports/survival/** and site/r/** are written by scripts/survival_report.py from `re audit --json` runs and never edited by hand; report directories are append-only; repository pages live at lowercase paths and carry no rank, no colour and no comparison.",
      "generator": "scripts/survival_report.py",
      "tests": "scripts/tests/test_survival_report.py"
    }
  },
  "forbidden_words": {
    "rule": "A measurement with a verdict attached stops being a measurement. None of these may appear on a public surface, in the README or in CLI output templates.",
    "words": [
      "🟢",
      "🟡",
      "🔴",
      "healthy",
      "high churn",
      "AI Waste",
      "waste score",
      "leaderboard",
      "zero false attribution",
      "first production issuer",
      "reference production issuer",
      "Trust Plane",
      "intent-addressable",
      "Trace intent. Debug causality",
      "the good virus",
      "without the agent's cooperation",
      "no agent integration required",
      "any agent",
      "in 10 seconds",
      "fonts.googleapis.com",
      "Croviatrust"
    ],
    "allow": {
      "site/method.html": [
        "high churn",
        "healthy"
      ],
      "ROADMAP.md": [
        "leaderboard",
        "healthy",
        "zero false attribution",
        "first production issuer",
        "Trust Plane",
        "🟢",
        "🟡",
        "🔴"
      ],
      "MANIFESTO.md": [
        "leaderboard"
      ],
      "DCO.md": [],
      "site/README.md": [],
      "docs/survival-report.md": [
        "leaderboard",
        "high churn",
        "healthy"
      ]
    }
  },
  "required_phrases": {
    "rule": "Every public surface that shows a number says what kind of number it is.",
    "by_file": {
      "README.md": [
        "not a grade",
        "What it cannot see",
        "causari.dev/method",
        "re seal verify"
      ],
      "site/index.html": [
        "not a grade",
        "What it cannot see",
        "/method",
        "Signed-off-by|DCO|Apache 2.0"
      ],
      "site/method.html": [
        "Reproduce or contest",
        "survival-optout.txt"
      ],
      "site/llms.txt": [
        "counts, not grades",
        "causari.dev/method",
        "causari.dev/verify"
      ],
      "action.yml": [
        "--summary"
      ],
      "site/reports/survival/index.html": [
        "counts, not grades",
        "survival-optout.txt",
        "/method",
        "feed.xml",
        "not a sample of all AI-assisted code"
      ],
      "site/r/index.html": [
        "counts, not grades",
        "/method",
        "badge.svg"
      ],
      "site/r/croviatrust/causari/index.html": [
        "counts, not grades",
        "/method",
        "re audit croviatrust/causari --json",
        "badge.svg"
      ],
      "docs/survival-report.md": [
        "not a quality judgement",
        "arXiv 2601.16809",
        "GitClear",
        "ZENODO_TOKEN"
      ],
      "site/verify/index.html": [
        "does not prove",
        "no network request",
        "re seal verify",
        "/method"
      ],
      "site/faq.html": [
        "\"@type\": \"FAQPage\"",
        "does not grade",
        "survival-optout.txt",
        "re seal verify",
        "/method"
      ],
      "site/compare.html": [
        "Different tools answer different questions",
        "not stated publicly",
        "not a grade",
        "re seal verify",
        "/verify/"
      ]
    }
  },
  "integration_matrix": {
    "rule": "The agent rows in README.md and site/index.html are the same set, in the same order, derived from the code.",
    "agents": [
      "Claude Code",
      "Aider",
      "Codex CLI",
      "Cursor",
      "Windsurf",
      "Cline"
    ]
  },
  "release": {
    "asset_pattern": "causari-${TAG}-${TARGET}.tar.gz",
    "rule": "release.yml, scripts/install.sh, scripts/install.ps1, action.yml and the registry launchers in packaging/ agree on the archive name.",
    "must_mention": {
      ".github/workflows/release.yml": [
        "causari-${TAG}-${{ matrix.target }}",
        "actions/attest@",
        "SHA256SUMS.txt"
      ],
      "scripts/install.sh": [
        "causari-${VERSION}-${target}.tar.gz",
        "SHA256SUMS.txt"
      ],
      "scripts/install.ps1": [
        "causari-$Version-$target.zip",
        "SHA256SUMS.txt"
      ],
      "action.yml": [
        "causari-$VERSION-$TARGET.tar.gz",
        "SHA256SUMS.txt"
      ],
      "packaging/npm/lib/shim.js": [
        "`causari-v${ver}-${tgt}.${ext}`",
        "SHA256SUMS.txt"
      ],
      "packaging/pypi/causari_shim/__init__.py": [
        "f\"causari-v{version}-{tgt}.{ext}\"",
        "SHA256SUMS.txt"
      ]
    }
  },
  "live": {
    "base": "https://causari.dev",
    "pages": {
      "/": "It has causes",
      "/method": "Reproduce or contest",
      "/faq": "\"@type\": \"FAQPage\"",
      "/compare": "Different tools answer different questions",
      "/llms.txt": "not grades",
      "/robots.txt": "Sitemap",
      "/sitemap.xml": "causari.dev/verify/",
      "/install.sh": "SHA256SUMS.txt",
      "/install.ps1": "SHA256SUMS.txt",
      "/assets/favicon.svg": "<svg",
      "/assets/mark.svg": "<svg",
      "/reports/survival/": "Survival Report",
      "/reports/survival/feed.xml": "<feed",
      "/reports/survival/latest.json": "causari.survival_report.v1",
      "/r/": "Measured repositories",
      "/r/croviatrust/causari/": "re audit croviatrust/causari --json",
      "/r/croviatrust/causari/badge.svg": "AI code survival",
      "/r/croviatrust/causari/latest.json": "causari.repo_survival.v1",
      "/verify/": "does not prove",
      "/verify/seal-core.js": "CROVIA-SEAL-v1",
      "/verify/verify.js": "causari.audit-seal.v1"
    },
    "redirects": {
      "/repo": "/reports/survival/",
      "/assets/icon.svg": "/assets/favicon.svg",
      "/assets/og-card.png": "/assets/og.png",
      "/cla": "DCO.md",
      "/survival": "/reports/survival/",
      "/report": "/reports/survival/",
      "/survival-data.json": "/reports/survival/latest.json",
      "/verify": "/verify/",
      "/seal": "/verify/",
      "/r/Aider-AI/aider/": "/r/aider-ai/aider/"
    },
    "data": {
      "rule": "Every data path must answer a plain script: no browser, no cookie, the default User-Agent of Python's urllib. A 403 here means a Cloudflare Browser Integrity Check or a bot rule is blocking the very clients the reproducibility claim invites.",
      "paths": {
        "/reports/survival/latest.json": "\"schema\": \"causari.survival_report.v1\"",
        "/reports/survival/2026/01/report.json": "\"number\": 1",
        "/reports/survival/2026/01/repos/openai__codex.json": "\"coverage\"",
        "/reports/survival/feed.xml": "<feed",
        "/r/index.html": "<!doctype html>",
        "/sitemap.xml": "<urlset",
        "/llms.txt": "causari"
      }
    },
    "headers": {
      "/": {
        "content-security-policy": "default-src 'self'",
        "x-frame-options": "DENY"
      },
      "/install.sh": {
        "content-type": "text/x-shellscript"
      },
      "/reports/survival/feed.xml": {
        "content-type": "application/atom+xml"
      },
      "/reports/survival/latest.json": {
        "content-type": "application/json"
      },
      "/r/croviatrust/causari/badge.svg": {
        "content-type": "image/svg+xml",
        "cache-control": "max-age=3600"
      },
      "/r/croviatrust/causari/latest.json": {
        "content-type": "application/json",
        "cache-control": "max-age=3600"
      },
      "/verify/": {
        "content-security-policy": "connect-src 'none'",
        "x-frame-options": "DENY"
      }
    },
    "forbidden_live_words": [
      "Trace intent",
      "fonts.googleapis.com",
      "og-card.png",
      "/assets/icon.svg\"",
      "🟢",
      "🔴",
      "leaderboard.html",
      "survival.js",
      "re proof"
    ]
  }
}
